HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Use a long random value before accepting POSH webhook deliveries.
POSH_WEBHOOK_TOKEN=
# Required when serving behind a production HTTPS reverse proxy.
PUBLIC_ORIGIN=http://localhost:3000
# Set true only when public access uses HTTPS.
COOKIE_SECURE=false
# Required for first owner creation when NODE_ENV=production. Use a random 32+ character token.
SETUP_TOKEN=
# Optional encrypted saved-password vault. Generate with `npm run browser:key`.
# Keep this key separate from the persistent data volume (Fly secret in production).
BROWSER_VAULT_KEY=
# Approved navigation domains; exact host and subdomains. Add login-provider hosts only after review.
BROWSER_ALLOWED_HOSTS=posh.vip
